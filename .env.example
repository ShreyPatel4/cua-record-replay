# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic API key, needed only for `cua discover`. Replay never uses it.
ANTHROPIC_API_KEY=
CUA_MODEL=claude-sonnet-4-6

# Operator credentials for the local CoreLedger mock app.
# Both the mock app and the automation read these; neither hardcodes them.
# Pick any password you like. It is left blank here on purpose so no committed
# file ever holds a working credential.
# Use an id that is not a dictionary word: it is redacted as a whole token in logs and page text.
CORELEDGER_OPERATOR_USER=teller-0417
CORELEDGER_OPERATOR_PASSWORD=

# Session lifetime for the mock app, in seconds.
CORELEDGER_SESSION_TTL_S=900
CORELEDGER_PORT=5050
